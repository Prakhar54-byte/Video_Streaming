{
    "cSpell.words": [
        "calt",
        "MERN",
        "Nunito",
        "pids",
        "prakhar",
        "rlig",
        "veemau",
        "vercel"
    ],
    "peacock.color": "#0a0a0f",

    "markdown-previewEnhanced.keys.toggle": "ctrl+shift+v",

    "editor.fontSize": 14,
    "editor.fontFamily": "'JetBrains Mono', 'Fira Code', monospace",
    "editor.fontLigatures": true,
    "editor.lineHeight": 26,
    "editor.letterSpacing": 0.5,
    "editor.cursorBlinking": "phase",
    "editor.cursorSmoothCaretAnimation": "on",
    "editor.cursorWidth": 2,
    "editor.smoothScrolling": true,
    "editor.minimap.enabled": true,
    "editor.minimap.maxColumn": 90,
    "editor.minimap.showSlider": "mouseover",
    "editor.lineNumbers": "on",
    "editor.lineNumbersMinChars": 4,
    "editor.renderWhitespace": "selection",
    "editor.bracketPairColorization.enabled": true,
    "editor.guides.bracketPairs": true,
    "editor.indentGuides": "enabled",
    "editorIndentGuide.background1": "#ffffff08",
    "editorIndentGuide.activeBackground1": "#e9456040",

    "terminal.integrated.fontFamily": "'JetBrains Mono', 'Fira Code', monospace",
    "terminal.integrated.fontSize": 12,
    "terminal.integrated.lineHeight": 1.2,
    "terminal.integrated.cursorStyle": "line",
    "terminal.integrated.cursorBlink": true,
    "terminal.integrated.cursorWidth": 2,
    "terminal.integrated.scrollback": 10000,

    "workbench.colorCustomizations": {
        "activityBar.background": "#0a0a0f",
        "activityBar.foreground": "#e94560",
        "activityBar.activeBackground": "#1a1a2e",
        "activityBarBadge.background": "#e94560",
        "activityBarBadge.foreground": "#ffffff",
        "statusBar.background": "#050508",
        "statusBar.foreground": "#888888",
        "statusBarItem.remoteBackground": "#050508",
        "statusBarItem.remoteForeground": "#e94560",
        "titleBar.activeBackground": "#0a0a0f",
        "titleBar.activeForeground": "#cccccc",
        "titleBar.inactiveBackground": "#050508",
        "titleBar.inactiveForeground": "#666666",
        "editor.background": "#0a0a0f",
        "editor.foreground": "#e0e0e0",
        "editorCursor.foreground": "#e94560",
        "editor.lineHighlightBackground": "#e9456015",
        "editor.selectionBackground": "#e9456040",
        "editor.inactiveSelectionBackground": "#e9456020",
        "editorIndentGuide.background": "#ffffff08",
        "editorIndentGuide.activeBackground": "#e9456040",
        "editorBracketMatch.background": "#e9456030",
        "editorBracketMatch.border": "#e94560",
        "terminal.background": "#050508",
        "terminal.foreground": "#cccccc",
        "terminal.ansiBlack": "#050508",
        "terminal.ansiRed": "#e94560",
        "terminal.ansiGreen": "#32ff7e",
        "terminal.ansiYellow": "#facc15",
        "terminal.ansiBlue": "#3b82f6",
        "terminal.ansiMagenta": "#a855f7",
        "terminal.ansiCyan": "#06b6d4",
        "terminal.ansiWhite": "#e0e0e0"
    },
    "workbench.startupEditor": "welcomePage",
    "workbench.editor.enablePreview": false,
    "workbench.list.smoothScrolling": true,
    "workbench.sideBar.smoothScrolling": true,
    "workbench.tree.smoothScrolling": true,

    "prettier.singleQuote": true,
    "prettier.tabWidth": 4,
    "prettier.semi": true,
    "prettier.trailingComma": "es5",
    "prettier.bracketSpacing": true,
    "prettier.arrowParens": "always",
    "prettier.endOfLine": "lf",

    "eslint.validate": [
        "javascript",
        "javascriptreact",
        "typescript",
        "typescriptreact"
    ],
    "eslint.format.enable": true,
    "eslint.workingDirectories": [
        {
            "mode": "auto"
        }
    ],

    "explorer.confirmDelete": false,
    "explorer.confirmDragAndDrop": false,
    "files.autoSave": "afterDelay",
    "files.autoSaveDelay": 1000,

    "window.menuBarVisibility": "toggle",
    "window.newWindowTitleFormat": "Spark - ${appName}: ${folderOrFile}",

    "git.enableSmartCommit": true,
    "git.autofetch": true,
    "git.suggestSmartCheckout": true
}