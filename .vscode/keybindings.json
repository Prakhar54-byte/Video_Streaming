[
    {
        "key": "ctrl+shift+v",
        "command": "markdown-previewEnhanced.toggle",
        "when": "!terminalFocus"
    },
    {
        "key": "ctrl+`",
        "command": "workbench.action.terminal.toggleTerminal",
        "when": "terminalFocus"
    },
    {
        "key": "ctrl+b",
        "command": "workbench.action.toggleSidebar",
        "when": "!terminalFocus"
    },
    {
        "key": "ctrl+shift+n",
        "command": "workbench.action.terminal.new",
        "when": "terminalFocus"
    },
    {
        "key": "ctrl+shift+t",
        "command": "workbench.action.reopenClosedEditor",
        "when": "!terminalFocus"
    }
]