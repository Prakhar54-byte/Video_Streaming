# =============================================================================
# SPARK BACKEND - PRODUCTION ENV TEMPLATE
# =============================================================================
# Copy this to your .env file and fill in the values
# For Render: Add these as Environment Variables in the dashboard
# =============================================================================

# Required - Server
NODE_ENV=production
PORT=8000
LOG_LEVEL=info

# Required - Database (Get from MongoDB Atlas)
MONGODB_URL=mongodb+srv://...

# Required - JWT Secrets (Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
ACCESS_TOKEN_SECRET=<generate-32-chars>
REFRESH_TOKEN_SECRET=<generate-32-chars>

# Required - Cloudinary (Get from cloudinary.com)
CLOUDINARY_CLOUD_NAME=<your-cloud-name>
CLOUDINARY_API_KEY=<your-api-key>
CLOUDINARY_API_SECRET=<your-api-secret>

# Required - CORS (Your Vercel URL)
ALLOWED_ORIGINS=https://your-app.vercel.app

# Optional - Redis (Leave default for Render free tier)
# REDIS_HOST=localhost
# REDIS_PORT=6379

# Optional - Admin Key
ADMIN_SECRET_KEY=<generate-optional>

# Optional - Rate Limits
# RATE_LIMIT_MAX=100